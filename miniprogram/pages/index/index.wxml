<!--index.wxml-->
<navigation-bar title="视频保存" back="{{false}}" color="black" background="#FFF"></navigation-bar>
<scroll-view class="scrollarea" scroll-y type="list">
  <view class="page">
    <view class="card">
      <textarea
        class="input"
        value="{{text}}"
        bindinput="onInput"
        placeholder="粘贴视频分享文案或视频直链，例如：8.23 gAh:/ 复制打开抖音 https://v.douyin.com/xxxx/"
        placeholder-class="input-ph"
        maxlength="2000"
        show-confirm-bar="{{false}}"
      ></textarea>
      <view class="input-actions">
        <view class="text-btn" bindtap="onPaste">粘贴剪贴板</view>
        <view class="text-btn" wx:if="{{text}}" bindtap="onClear">清空</view>
      </view>
    </view>

    <view class="primary-btn {{busy ? 'is-disabled' : ''}}" bindtap="onSubmit">
      {{(phase === 'parsing' || phase === 'downloading') ? '提取中…' : '开始提取'}}
    </view>

    <view class="card result-card" wx:if="{{result}}">
      <image class="cover" wx:if="{{result.cover}}" src="{{result.cover}}" mode="aspectFill"></image>
      <view class="result-main">
        <view class="result-title">{{result.title || '视频'}}</view>
        <view class="result-meta">
          <text wx:if="{{result.author}}">{{result.author}}</text>
          <text wx:if="{{sizeText && sizeText !== '—'}}"> · {{sizeText}}</text>
        </view>

        <view class="progress-wrap" wx:if="{{busy || phase === 'done'}}">
          <view class="progress-bar">
            <view class="progress-inner" style="width: {{progress}}%;"></view>
          </view>
          <view class="progress-text">
            <text>{{progressText}}</text>
            <text wx:if="{{busy && phase === 'downloading'}}" class="cancel" bindtap="onCancel">取消</text>
          </view>
        </view>
      </view>
    </view>

    <view class="row-actions" wx:if="{{result && (phase === 'ready' || phase === 'done')}}">
      <view class="ghost-btn" bindtap="onCopyLink">复制链接</view>
      <view class="save-btn {{busy ? 'is-disabled' : ''}}" bindtap="onSave">
        {{busy ? '保存中…' : (phase === 'done' ? '再次保存' : '保存视频')}}
      </view>
    </view>

    <view class="share-row" wx:if="{{result && (phase === 'ready' || phase === 'done')}}">
      <button class="ghost-btn share-btn" open-type="share">分享给好友</button>
    </view>

    <view class="ad-tip" wx:if="{{result && phase === 'ready' && !adFree}}">
      今日首次保存需观看一小段广告，之后 24 小时内保存不再提示
    </view>

    <view class="error" wx:if="{{error}}">{{error}}</view>

    <ad wx:if="{{adUnitId}}" class="ad-slot" unit-id="{{adUnitId}}" ad-type="banner" ad-theme="white"></ad>

    <view class="tips">
      <view class="tips-title">使用说明</view>
      <view class="tips-item">1. 在抖音 App 中点击「分享 → 复制链接」。</view>
      <view class="tips-item">2. 回到本页粘贴文案，点击「开始提取」。</view>
      <view class="tips-item">3. 「保存视频」和「复制链接」每日首次使用需观看一小段广告，24 小时内不再提示。</view>
      <view class="tips-item">4. 保存成功后在系统相册查看；「历史」页可回看保存记录。</view>
    </view>
  </view>
</scroll-view>
